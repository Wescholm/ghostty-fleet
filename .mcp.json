{
  "mcpServers": {
    "xcode": {
      "type": "stdio",
      "command": "/Applications/Xcode.app/Contents/Developer/usr/bin/mcpbridge"
    },
    "XcodeBuildMCP": {
      "command": "xcodebuildmcp",
      "args": [
        "mcp"
      ],
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      }
    },
    "peekaboo": {
      "type": "stdio",
      "command": "peekaboo",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  }
}